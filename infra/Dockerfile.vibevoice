# Dockerfile.vibevoice — main server (port 8080)
#
# Use this for a self-hosted (non-RunPod) deployment where you want
# everything in a container. On RunPod we deploy directly via
# bootstrap_new_pod.sh because their pods ARE containers and there's
# no value in nesting one inside another.
#
# Build:
#   docker build -f infra/Dockerfile.vibevoice -t mostashar-voice:v5 .
# Run (with persistent HF cache + voice library on the host):
#   docker run -d --name vibevoice --gpus all -p 8080:8080 \
#       -v hf-cache:/workspace/hf-cache \
#       -v /path/to/voices:/workspace/refs/voices \
#       -e MV_API_KEY=your-key \
#       -e MV_GEMMA4_URL=http://gemma4:8082 \
#       mostashar-voice:v5

# ---- 1. CUDA base ---------------------------------------------------
# Uses the same CUDA + cuDNN versions our flash-attn build was tested
# against. nvidia/cuda:12.1.1-devel includes the headers + nvcc that
# flash-attn needs at install time; the runtime variant doesn't.
FROM nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04

# Non-interactive apt + clean Python locale.
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/workspace/hf-cache

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.10 python3.10-venv python3-pip \
        git curl ca-certificates lsof \
        ffmpeg libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

# Make python3 → python3.10
RUN ln -sf /usr/bin/python3.10 /usr/local/bin/python && \
    ln -sf /usr/bin/python3.10 /usr/local/bin/python3 && \
    pip install --upgrade pip wheel

# ---- 2. Python deps ------------------------------------------------
WORKDIR /workspace

# torch first so its build matches the cuda layer.
RUN pip install \
    'torch==2.4.0' 'torchaudio==2.4.0' \
    --index-url https://download.pytorch.org/whl/cu121

RUN pip install \
    'transformers>=4.51,<5.0' 'accelerate>=0.30' \
    'fastapi>=0.110' 'uvicorn[standard]>=0.27' \
    'pydantic>=2.0' \
    'numpy<2' 'soundfile>=0.12' 'librosa>=0.10' \
    'httpx>=0.25'

# flash-attn needs nvcc + the matching torch — the previous layer
# satisfies both. Failures here usually mean the host GPU + cuda
# combo is unsupported; set --build-arg SKIP_FLASH_ATTN=1 to skip
# (server runs ~1.5x slower without it but still functional).
ARG SKIP_FLASH_ATTN=0
RUN if [ "$SKIP_FLASH_ATTN" = "0" ]; then \
        pip install flash-attn==2.6.3 --no-build-isolation || \
            echo "WARN: flash-attn install failed, continuing"; \
    fi

# VibeVoice community fork — provides the patched model classes.
RUN git clone https://github.com/myshell-ai/VibeVoice-Community.git /workspace/vv-community && \
    pip install -e /workspace/vv-community

# ---- 3. App code ---------------------------------------------------
# Copy ONLY the streaming module (everything else in the repo —
# tests, scripts, alternate engines — is dev-time only).
COPY vibevoice_streaming/server_v5_api.py /workspace/server_v5_api.py
COPY vibevoice_streaming/gemma4_server.py /workspace/gemma4_server.py
COPY vibevoice_streaming/openvoice_server.py /workspace/openvoice_server.py
COPY infra/start_server.sh /usr/local/bin/start-vibevoice
RUN chmod +x /usr/local/bin/start-vibevoice

# ---- 4. Runtime ----------------------------------------------------
# /workspace/refs/voices and /workspace/hf-cache should be bind-mounted
# from the host (or named volumes) so they survive container restarts.
VOLUME ["/workspace/refs/voices", "/workspace/hf-cache"]
EXPOSE 8080

# Don't bake the API key into the image. Pass it at run time via -e
# MV_API_KEY=... or via docker secrets.
ENV MV_PORT=8080 \
    MV_VOICES_DIR=/workspace/refs/voices \
    MV_WHISPER_MODEL=openai/whisper-large-v3 \
    MV_WHISPER_LANGUAGE=ar

# Health check — the start script needs ~90 s for warmup, so the
# initial probe waits longer.
HEALTHCHECK --start-period=120s --interval=30s --timeout=5s --retries=3 \
    CMD curl -fsS "http://127.0.0.1:${MV_PORT}/v1/health" \
        | grep -q '"whisper_loaded": *true' || exit 1

CMD ["start-vibevoice"]
